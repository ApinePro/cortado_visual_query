{
  "name": "cortado",
  "version": "1.3.0-beta",
  "main": "app/main-electron.js",
  "author": "Daniel Schuster (Fraunhofer FIT)",
  "description": "An Interactive Tool for Data-Driven Process Discovery and Modeling",
  "directories": {
    "app": "app"
  },
  "build": {
    "appId": "Cortado",
    "files": [
      "node_modules/tree-kill",
      "dist",
      "main-electron.js",
      "license-dialog.html",
      "license-dialog.css",
      "license-dialog.js"
    ],
    "win": {
      "target": "portable",
      "icon": "icon/cortado_icon_colorful_transparent.ico"
    },
    "linux": {
      "target": "dir",
      "icon": "icon/512x512.png",
      "executableName": "Cortado",
      "category": "Science"
    }
  },
  "scripts": {
    "build-app-production-windows": "electron-builder build -w",
    "build-app-production-linux": "electron-builder build -l"
  },
  "devDependencies": {
    "electron-builder": "^22.14.5",
    "electron": "^16.0.1"
  }
}
